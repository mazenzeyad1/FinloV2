# Database
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/FinloV2?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_MS="2592000000"

# App
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Logging
LOG_LEVEL="debug"

# Email (Brevo)
# Preferred in production: Brevo HTTP API (HTTPS/443) — required on hosts that
# block outbound SMTP (e.g. Render). Create a v3 API key in Brevo:
# SMTP & API -> API Keys. When set, this is used instead of SMTP_*.
BREVO_API_KEY="your-brevo-v3-api-key"
# SMTP is the local-dev fallback (used only when BREVO_API_KEY is unset).
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER="your-brevo-email@example.com"
SMTP_PASS="your-brevo-smtp-key"
MAIL_FROM="no-reply@finlo.ca"
MAIL_FROM_NAME="Finlo"

# Plaid
PLAID_CLIENT_ID="your-client-id"
PLAID_SECRET="your-sandbox-secret"
PLAID_ENV="sandbox"

# Groq (free AI categorization — get key at console.groq.com)
GROQ_API_KEY="gsk_..."

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
